{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:speclint:results:2",
  "title": "speclint results",
  "description": "Output of `speclint check`, optionally extended by `--classify` and `speclint merge`. Each item is graded from the severity caps of its active findings; an item without active findings gets \"none\".",
  "type": "object",
  "required": ["tool", "schema_version", "profile", "categories", "rules", "requirements", "summary"],
  "additionalProperties": false,
  "properties": {
    "tool": { "const": "speclint" },
    "schema_version": { "const": 2 },
    "profile": {
      "description": "Profile the run used: a built-in name or the path of a profile file. Grades from different profiles are not comparable.",
      "type": "object",
      "required": ["name", "ears"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "ears": { "type": "boolean", "description": "EARS conformance checked (--ears)." }
      }
    },
    "categories": {
      "description": "Category key to display name.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "rules": {
      "description": "Rule key to rule definition with its effective severity, for every rule the profile runs.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["category", "incose", "severity", "message"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "incose": { "type": "string", "description": "INCOSE GtWR rule numbers the check is inspired by, e.g. \"R7, R34\"." },
          "severity": { "$ref": "#/$defs/severity" },
          "message": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "summary": {
      "type": "object",
      "required": ["requirements", "graded", "needs_clarification", "grades", "categories", "rules", "dismissed"],
      "additionalProperties": false,
      "properties": {
        "requirements": { "type": "integer", "minimum": 0, "description": "All items read." },
        "graded": { "type": "integer", "minimum": 0, "description": "Items not classified as information." },
        "needs_clarification": { "type": "integer", "minimum": 0, "description": "Graded items with at least one finding that is not dismissed." },
        "categories": { "description": "Findings per category over graded items, dismissed findings excluded.", "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "grades": {
          "description": "Number of graded items per grade, \"none\" included.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/grade" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "rules": {
          "description": "Findings per rule over graded items, dismissed findings excluded.",
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "dismissed": { "type": "integer", "minimum": 0, "description": "Findings dismissed in review, over all items." }
      }
    }
  },
  "$defs": {
    "severity": { "enum": ["error", "warning", "info"] },
    "grade": { "enum": ["A", "B", "C", "D", "F", "none"] },
    "requirement": {
      "type": "object",
      "required": ["id", "source", "text", "lang", "findings", "grade"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string", "description": "Input file the item was read from." },
        "text": { "type": "string" },
        "lang": { "enum": ["en", "de"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "grade": { "$ref": "#/$defs/grade" },
        "classification": {
          "description": "Present with `check --classify`. Items with an obligation verb are always requirements (model \"obligation verb\").",
          "type": "object",
          "required": ["model", "kind", "score"],
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "kind": { "enum": ["requirement", "information"] },
            "score": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "review": {
          "description": "Present after `speclint merge` for reviewed items.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question": { "type": "string", "description": "Clarification question for the customer, in the item's language." },
            "rewrite": { "type": "string", "description": "Suggested text; unknown values appear as [TBD: ...] placeholders." }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule", "match", "start", "end", "severity", "category", "incose", "message"],
      "additionalProperties": false,
      "properties": {
        "rule": { "type": "string" },
        "match": { "type": "string", "description": "Matched text, equal to text[start:end]." },
        "start": { "type": "integer", "minimum": 0, "description": "Character offset (Unicode code points) into the requirement text." },
        "end": { "type": "integer", "minimum": 0 },
        "severity": { "$ref": "#/$defs/severity" },
        "category": { "type": "string" },
        "incose": { "type": "string" },
        "message": { "type": "string" },
        "related": {
          "description": "Whole-spec rules: the other items with the same finding. key is the position in requirements (IDs can repeat across files).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "id"],
            "additionalProperties": false,
            "properties": { "key": { "type": "integer", "minimum": 0 }, "id": { "type": "string" } }
          }
        },
        "dismissed": { "type": "boolean", "description": "Set by review; dismissed findings do not count towards the grade." },
        "review_reason": { "type": "string" }
      }
    }
  }
}
